{
  "name": "gogmeet",
  "version": "1.20.1",
  "author": "iWorkforces Engineers",
  "repository": "https://github.com/iWorkforces/GogMeet",
  "authorEmail": "chitrung09t2@gmail.com",
  "description": "GogMeet is a desktop application that helps you keep track of your meetings and reminds you before they start.",
  "main": "lib/main/index.cjs",
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@eslint/js": "^10.0.1",
    "@rsbuild/core": "^2.2.5",
    "@rslib/core": "^1.0.0",
    "@rspack/core": "^2.2.3",
    "@tsconfig/node24": "^24.0.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/browser": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-prettier": "^5.5.6",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "engineStrict": true,
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.3.0"
  },
  "homepage": "https://github.com/iWorkforces/GogMeet",
  "packageManager": "bun@1.4.1",
  "private": true,
  "productName": "GogMeet",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "build": "bun run build:main && bun run build:preload && bun run build:renderer",
    "build:main": "rslib build -c rslib.config.ts",
    "build:preload": "rslib build -c rslib.config.preload.ts",
    "build:renderer": "rsbuild build",
    "package": "bun run package:mac",
    "package:mac": "bun run build && electron-builder --mac --publish never",
    "package:dir": "bun run package:mac:dir",
    "package:mac:dir": "bun run build && electron-builder --mac --dir --publish never",
    "package:win": "bun run build && electron-builder --win --publish never",
    "package:win:x64": "bun run build && electron-builder --win nsis portable --x64 --publish never",
    "package:win:arm64": "bun run build && electron-builder --win nsis portable --arm64 --publish never",
    "package:win:dir": "bun run build && electron-builder --win --dir --publish never",
    "verify:macos-release": "node scripts/verify-macos-release.mjs",
    "verify:windows-release": "node scripts/verify-windows-release.mjs",
    "merge:windows-latest-yml": "node scripts/merge-windows-latest-yml.mjs",
    "typecheck": "bun ./node_modules/@typescript/native/bin/tsc --build",
    "validate:node": "node scripts/validate-node.mjs",
    "test": "vitest run -c vitest.workspace.ts",
    "test:watch": "vitest -c vitest.workspace.ts",
    "test:coverage": "vitest run -c vitest.workspace.ts --coverage",
    "bench:calendar-parser": "vitest bench -c vitest.bench.config.ts tests/bench/calendar-parser.bench.ts",
    "perf:report": "node scripts/performance/report.mjs",
    "perf:workspace-fingerprint": "node scripts/performance/workspace-fingerprint.mjs",
    "perf:google": "node scripts/performance/measure-google-calendar.mjs",
    "perf:tray": "node scripts/performance/measure-tray.mjs",
    "perf:safe-storage": "node scripts/performance/measure-safe-storage.mjs",
    "perf:startup": "node scripts/performance/measure-startup.mjs",
    "perf:alert": "node scripts/performance/measure-alert.mjs",
    "perf:build-package": "node scripts/performance/measure-build-package.mjs",
    "perf:lab": "bun run perf:google && bun run perf:tray && bun run perf:safe-storage && bun run perf:startup && bun run perf:alert && bun run perf:build-package",
    "check:swift-package-layout": "node scripts/check-swift-package-layout.mjs",
    "guardrails": "node scripts/guardrails-scan.mjs",
    "guardrails:self-test": "node scripts/guardrails-scan.mjs --self-test",
    "guardrails:tests": "vitest run -c vitest.workspace.ts --project main tests/main/guardrails-security.test.ts tests/main/browser-window.test.ts tests/main/google-token-store.test.ts tests/main/offline-cache.test.ts tests/main/join-meeting.test.ts tests/main/calendar-refresh-coordinator.test.ts tests/main/scheduler-poll.test.ts tests/main/performance-trace.test.ts --project scripts tests/scripts/guardrails-scan.test.ts tests/scripts/performance-report.test.ts",
    "clean": "rimraf lib dist",
    "lint": "eslint src/ --cache",
    "format:check": "prettier --check \"src/**/*.{ts,css}\"",
    "format": "prettier --write \"src/**/*.{ts,css}\""
  },
  "sideEffects": [
    "**/*.css",
    "**/shared/utils/as.ts",
    "**/shared/utils/as.js"
  ],
  "type": "module"
}
